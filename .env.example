# Primary provider (recommended): OpenRouter
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional low-call mode (1 AI call per message). Set 0 for full extraction+compression.
# AI_SAVE_QUOTA=1
# Optional embedding backend: lite | sentence-transformers | vljepa
# EMBEDDING_BACKEND=lite

# Session signing key for auth cookies (set a long random value in production)
# FLASK_SECRET_KEY=change_me
# Optional: override SQLite path (useful for Render persistent disks)
# MEMORY_DB_PATH=/var/data/memories.db

# Use VL-JEPA for embeddings (Mac/Apple Silicon only; requires mlx + vljepa)
# USE_VLJEPA=1
